{
  "name": "awesome-automated-ai",
  "version": "2026.11.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p tests",
    "discover": "node src/cli.ts discover",
    "generate": "node src/cli.ts generate",
    "refresh-tags": "node src/cli.ts refresh-tags",
    "reclassify": "node src/cli.ts reclassify",
    "validate": "node src/cli.ts validate",
    "check-links": "node src/cli.ts check-links",
    "audit": "node src/cli.ts audit",
    "site-data": "node src/generator/site-data.ts",
    "bump-version": "node scripts/bump-version.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
