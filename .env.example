# Nothing loads this file by itself. Copy it to .env and either export the
# values or pass the file to node:
#   node --env-file=.env src/cli.ts discover

# Claude API (required by discover, reclassify and refresh-tags)
ANTHROPIC_API_KEY=sk-ant-...

# Override the Claude model for all three (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# GitHub token (GH_TOKEN or GITHUB_TOKEN; GH_TOKEN wins when both are set;
# locally: GH_TOKEN=$(gh auth token)). discover also needs it to open PRs.
GITHUB_TOKEN=ghp_...

# The repository discover opens its PRs against (read by discover only)
GITHUB_REPO_OWNER=jbogocz
GITHUB_REPO_NAME=awesome-automated-ai

# Discovery decisions log, relative to projects.yaml's directory (default: data/decisions.jsonl)
DECISIONS_PATH=data/decisions.jsonl

# Tuning (optional, defaults shown)
MAX_CANDIDATES_PER_RUN=50
SCORE_THRESHOLD_AUTO=70
SCORE_THRESHOLD_QUEUE=50
MAX_PRS_PER_DAY=3

# "true" logs what discovery would do without opening PRs or recording decisions;
# only "true" or "false" are accepted. refresh-tags has its own --dry-run flag.
DRY_RUN=false

# Logging verbosity: error | warn | info | debug (default: info)
# LOG_LEVEL=debug

# Where audit and check-links append their findings instead of printing them
# (the --report=FILE flag does the same)
# DRIFT_REPORT=audit-report.md
