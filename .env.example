# Nothing loads this file by itself. Copy it to .env and either export the
# values or pass the file to node:
#   node --env-file=.env src/cli.ts discover

# Claude API (required by discover, reclassify and refresh-tags)
ANTHROPIC_API_KEY=sk-ant-...

# Override the Claude model for all three (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# GitHub token (GH_TOKEN or GITHUB_TOKEN; locally: GH_TOKEN=$(gh auth token))
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=jbogocz
GITHUB_REPO_NAME=awesome-automated-ai

# Discovery decisions log (default: data/decisions.jsonl)
DECISIONS_PATH=data/decisions.jsonl

# Tuning (optional, defaults shown)
MAX_CANDIDATES_PER_RUN=50
SCORE_THRESHOLD_AUTO=70
SCORE_THRESHOLD_QUEUE=50
MAX_PRS_PER_DAY=3

# Set to "true" to log actions without opening PRs
DRY_RUN=false

# Logging verbosity: error | warn | info | debug (default: info)
# LOG_LEVEL=debug
