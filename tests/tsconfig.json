{
  // Type-checks the tests against the sources they import. Separate from the
  // root config so `pnpm run build` keeps rootDir=src and emits nothing extra.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["../src", ".", "../vitest.config.ts"],
  "exclude": []
}
